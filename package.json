{
  "name": "whygraph",
  "version": "0.1.2",
  "description": "The graph of why. So your agent knows before it touches anything.",
  "author": "Geovanie Ruiz",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "architecture",
    "decision",
    "adr",
    "claude",
    "cursor",
    "vibe-coding"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/geovanie-ruiz/whygraph.git"
  },
  "homepage": "https://github.com/geovanie-ruiz/whygraph#readme",
  "bugs": {
    "url": "https://github.com/geovanie-ruiz/whygraph/issues"
  },
  "type": "module",
  "bin": {
    "whygraph": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "npm run build && npm run build:frontend",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run build:frontend"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "graphology": "^0.25.0",
    "graphql": "^16.13.1",
    "graphql-ws": "^6.0.7",
    "graphql-yoga": "^5.18.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "nanoid": "^5.1.7",
    "open": "^11.0.0",
    "prompts": "^2.4.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
